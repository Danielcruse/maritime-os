# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://maritime:maritime@localhost:5432/maritime_os?schema=public

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Object storage (S3-compatible) for documents / evidence ---
# Not wired up yet — uploads currently always go to local disk (below),
# regardless of these. Kept here as the intended production config shape.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Local file storage (actually used right now; see docs/architecture.md) ---
# Where uploaded evidence/documents are written. Relative paths resolve
# against the process's cwd. Default: .local-data/uploads
LOCAL_UPLOAD_DIR=

# --- Redis (queues, rate limiting) ---
REDIS_URL=redis://localhost:6379

# --- Credential signing (issuer-side Ed25519 keypair, base64) ---
CREDENTIAL_SIGNING_PRIVATE_KEY=
CREDENTIAL_SIGNING_PUBLIC_KEY=

# --- Blockchain (not required for MVP marketplace flow) ---
CHAIN_RPC_URL=
CHAIN_ID=
CHAIN_ANCHOR_CONTRACT_ADDRESS=
CHAIN_SIGNER_PRIVATE_KEY=

# --- App ---
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
